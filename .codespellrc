[codespell]
skip = *.lock,*.toml,./man/*.1,./crates/bear/build.rs
count = true
quiet-level = 3

# serde -> ser
# abd -> source matcher for ADA files
# Fo -> MSVC output flag /Fo
# Ot -> MSVC optimization flag /Ot
# gir -> GObject-Introspection .gir binding files (Vala)
# statics -> plural of the Rust `static` item
ignore-words-list = ser,abd,exect,Fo,Ot,gir,statics
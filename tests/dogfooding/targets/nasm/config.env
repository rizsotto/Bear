# SPDX-License-Identifier: GPL-3.0-or-later
#
# Pinned configuration for the x264 dogfooding target (Stage 7, assembler
# dialect). x264 is a production codebase that MIXES nasm and gcc: ~60 C
# translation units alongside ~20 hand-written .asm files assembled by nasm on
# x86_64. It validates that Bear now recognizes the nasm assembler dialect and
# records a well-formed entry for each .asm compile in a real build - not just
# the synthetic event order the integration tests simulate. A dogfooding
# configuration is (base image digest, target source revision, target build
# type); all are pinned so the checks stay stable (dogfood-pinned-target).
# Sourced by run.sh; SRC_DIR is also consumed by the target Containerfile via
# podman build --build-arg.

# Validation mode for this target: 'none'. x264 has no committed golden (its
# nasm/gcc command lines are not worth blessing and re-reviewing) and no CMake
# oracle (x264 uses a hand-written sh `configure`, like ffmpeg), so it is run
# ONLY with the target-agnostic on-demand checks. Per the Stage 7 plan the
# meaningful ones here are --invariants (structural well-formedness of BOTH the
# nasm and gcc entries, plus the entry-count cross-check) and --consumer (feeds
# the C entries to clang-tidy; it already filters to C-family sources, so the
# nasm entries are simply not sampled by it). run.sh dispatches on this selector.
# shellcheck disable=SC2034
VALIDATION="none"

# Pinned base image: the same digest zlib/curl/ffmpeg use (this IS fedora:44,
# the devcontainer base). An unpinned base would let a package update change the
# compiler or the nasm version under the fixed checks and produce phantom diffs.
# shellcheck disable=SC2034
BASE_IMAGE="registry.fedoraproject.org/fedora@sha256:3baf5f0dededfd939eb8f0b271ff8ad17bdb381cdd5768bd7d6f45bba795aa62"

# Fixed in-container build path (dogfood-fixed-paths). x264 builds IN-TREE:
# objects land next to their sources under /src and its configure has no
# out-of-tree mode, so source, objects, and build dir are all this one fixed
# path. A fixed path keeps absolute paths in 'directory' reproducible across
# runs (so the determinism check needs no normalization).
# shellcheck disable=SC2034
SRC_DIR="/src"

# Object-count instrument for the entry-count invariant (dogfood-invariants).
# x264's in-tree make leaves EVERY object on disk under /src and compiles each
# source (C and .asm) once PER BIT DEPTH - the 8-bit and 10-bit compiles of a
# depth-dependent source produce two distinct objects (predict-c-8.o and
# predict-c-10.o). Because this target runs Bear with a config that adds
# `arguments` to the duplicate match key (see bear.yaml and TARGET_BUILD_CMD),
# BOTH compiles are captured as distinct entries, so the DEFAULT instrument, a
# post-build `find $OBJECTS_DIR -name '*.o' | wc -l`, exactly equals Bear's entry
# count (verified on a real build: 114 objects == 114 entries). x264 therefore
# does NOT override OBJECT_COUNT_CMD - the config file, not a bespoke counting
# hack, is what makes the entry-count cross-check a true "did Bear capture every
# compile?" gate here.
# shellcheck disable=SC2034
OBJECTS_DIR="/src"

# Build directory passed to the replay/consumer sampler (dogfood-replay,
# dogfood-clang-consumer) as `cdb-compare sample --build-dir`. x264 builds
# in-tree, so its build dir IS /src.
# shellcheck disable=SC2034
BUILD_DIR="/src"

# Tolerance percent for the entry-count band
# (--expected-objects N --tolerance OBJECT_TOLERANCE_PCT). x264 compiles each C
# and each .asm source exactly once and leaves the object on disk, so `find`
# tracks Bear's entry count tightly; 10% absorbs an incidental generated object
# (e.g. config-probe scratch) across x264 revisions without a false fail.
# shellcheck disable=SC2034
OBJECT_TOLERANCE_PCT="10"

# Per-target preflight minimum free disk on the podman graphroot, in KiB
# (dogfood-preflight). x264 is small (~114 objects), but the base + target
# images still dominate; ~4 GiB is a safe floor consistent with the other
# targets.
# shellcheck disable=SC2034
MIN_FREE_KIB="4194304"

# The build command run INSIDE the target container. Two phases:
#
#  1. CONFIGURE (NOT wrapped by Bear - x264's configure is a hand-written sh
#     script that probes the toolchain, detects nasm for the x86_64 assembly,
#     and writes config.mak; it is not a compile). No flags are needed for a
#     minimal build: configure links the cli and the library from just gcc +
#     nasm + make. --extra-cflags carries the determinism self-test hook.
#
#  2. BUILD wrapped by Bear -> Bear's capture at /out/compile_commands.json. The
#     build compiles the C TUs with gcc and the .asm TUs with nasm; Bear must
#     record an entry for each. --config points Bear at the target's bear.yaml
#     (baked into the image at /opt/bear-config/duplicates.yaml), which adds
#     `arguments` to the duplicate match key so x264's 8-bit and 10-bit
#     double-compiles are both kept (see bear.yaml and the OBJECTS_DIR note).
#
# INJECT_CFLAGS is the determinism self-test hook (dogfood-determinism): empty
# on every normal run and on determinism run 1, it carries a perturbing flag on
# determinism run 2 under --inject-fault. x264's configure accepts
# `--extra-cflags=...`, which appends to the recorded gcc arguments, so the
# fault lands in the capture and the two builds diverge. Empty
# `--extra-cflags=""` is a harmless no-op on a normal run. /src is fresh each run
# (a new container), so configure re-runs and the flag takes effect.
# shellcheck disable=SC2034
TARGET_BUILD_CMD='mkdir -p /out && cd /src && ./configure --extra-cflags="${INJECT_CFLAGS:-}" && ${RPROF_PREFIX:-} bear --config /opt/bear-config/duplicates.yaml --output /out/compile_commands.json -- make -j"$(nproc)"'
